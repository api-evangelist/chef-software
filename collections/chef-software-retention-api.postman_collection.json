              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": null,
            "body": {
              "mode": "raw",
              "raw": "{\n  \"threshold\": \"<string>\",\n  \"running\": \"<boolean>\",\n  \"recurrence\": \"<string>\",\n  \"job_info\": {\n    \"last_enqueued_at\": \"<dateTime>\",\n    \"last_started_at\": \"<dateTime>\",\n    \"last_ended_at\": \"<dateTime>\",\n    \"last_elapsed\": \"<string>\",\n    \"next_due_at\": \"<dateTime>\"\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
